{
  "name": "despues-dividimos",
  "version": "1.0.0",
  "description": "Application for managing shared expenses and balances between groups.",
  "keywords": [
    "expenses",
    "group-expenses",
    "shared-expenses",
    "finance",
    "backend",
    "typescript"
  ],
  "homepage": "https://github.com/Bruno-Sanchez-GH/Despues-dividimos.#readme",
  "bugs": {
    "url": "https://github.com/Bruno-Sanchez-GH/Despues-dividimos./issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bruno-Sanchez-GH/Despues-dividimos..git"
  },
  "license": "MIT",
  "author": "Bruno Nicolas Sanchez",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "npm run prisma:generate",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/balances.test.mjs",
    "test:e2e": "npm run build && npm --prefix frontend run build && node --experimental-vm-modules tests/e2e.mjs",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma7.config.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  }
}
